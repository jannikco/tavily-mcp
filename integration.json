  "appSlug": "tavily",
  "appName": "Tavily",
  "operationIds": [
    "search_web",
    "extract_urls"
  ],
  "sourceRevision": "283f830550511eff8da95ff4372011a99d48544d0b0ba29f73a064928b485718",
  "evidence": [
    "Actual tools/call and direct-provider request contract tests"
  ],
  "provenance": [
    "https://docs.tavily.com/documentation/api-reference/openapi.json"
  ],
  "attributionSlug": "github-tavily-mcp",
  "connectorId": "tavily",
  "connector": {
    "id": "tavily",
    "name": "Tavily",
    "version": "0.1.0",
    "baseUrl": "https://api.tavily.com",
    "auth": {
      "type": "bearer",
      "env": "TAVILY_API_KEY"
    },
    "description": "Search and extract public web content with explicit bounded input. Read requests consume provider credits; per-URL extraction failures remain visible in the raw result.",
    "tools": [
      {
        "name": "search_web",
        "description": "Search with bounded result count; provider usage/credits still apply to read-only calls.",
        "method": "POST",
        "path": "/search",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "max_results": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "search_depth": {
              "type": "string",
              "enum": [
                "basic",
                "advanced"
              ]
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        },
        "bindings": {
          "path": [],
          "query": {},
          "body": {
            "query": "query",
            "max_results": "max_results",
            "search_depth": "search_depth"
          }
        },
        "sampleArguments": {
          "query": "Qdrant vector database documentation",
          "max_results": 5,
          "search_depth": "basic"
        },
        "provenance": [
          "https://docs.tavily.com/documentation/api-reference/openapi.json"
        ]
      },
      {
        "name": "extract_urls",
        "description": "Extract supplied HTTPS URLs; inspect failed_results as well as results, even when HTTP status is 200.",
        "method": "POST",
        "path": "/extract",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "urls": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^https://[^\\s]+$"
              },
              "minItems": 1,
              "maxItems": 20
            },
            "extract_depth": {
              "type": "string",
              "enum": [
                "basic",
                "advanced"
              ]
            }
          },
          "required": [
            "urls"
          ],
          "additionalProperties": false
        },
        "bindings": {
          "path": [],
          "query": {},
          "body": {
            "urls": "urls",
            "extract_depth": "extract_depth"
          }
        },
        "sampleArguments": {
          "urls": [
            "https://qdrant.tech/documentation/"
          ],
          "extract_depth": "basic"
        },
        "provenance": [
          "https://docs.tavily.com/documentation/api-reference/openapi.json"
        ]
      }
    ],
    "provenance": [
      "https://docs.tavily.com/documentation/api-reference/openapi.json"
    ],
    "sourceEvidence": [
      {
