  "qualityVersion": 2,
  "title": "Tavily MCP server",
  "description": "Search for relevant documentation and pass selected result URLs to extraction. Review both extracted pages and per-URL failures before citing content. Provider credits apply.",
  "status": "ready",
  "verification": "mock-only",
  "releaseEligible": true,
  "maintainer": "jannikco",
